{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coding plan / subscription pricing entries",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "vendor",
      "name",
      "region",
      "kind",
      "price",
      "quota",
      "buyUrl",
      "sourceUrl",
      "verifiedAt",
      "status",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "全局唯一 slug，跨版本不可改名"
      },
      "vendor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "region": {
        "enum": [
          "cn",
          "global"
        ]
      },
      "kind": {
        "enum": [
          "coding-plan",
          "token-plan",
          "ide",
          "free"
        ],
        "description": "coding-plan=厂商官方额度包；token-plan=按额度/积分包；ide=编辑器或 Agent 工具订阅；free=免费额度"
      },
      "price": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "currency",
          "period"
        ],
        "properties": {
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "enum": [
              "CNY",
              "USD"
            ]
          },
          "period": {
            "enum": [
              "month",
              "quarter",
              "year",
              "week",
              "none"
            ]
          },
          "firstPeriodAmount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          }
        }
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 60
        },
        "description": "该档位可调用的主力模型，写官方模型 id"
      },
      "quota": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "description": "官方原文额度描述的紧凑转述；无公开额度就写「官方未公开」"
      },
      "quotaWindow": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "fiveHours": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 160,
            "description": "官方额度数值或文字口径；单位见 quotaUnit"
          },
          "week": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 160,
            "description": "官方额度数值或文字口径；单位见 quotaUnit"
          },
          "month": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 160,
            "description": "官方额度数值或文字口径；单位见 quotaUnit"
          }
        }
      },
      "tokenAllowance": {
        "type": [
          "object",
          "null"
        ],
        "description": "仅当官方明确给出 token 数量时填写，用于估算额度价值；否则为 null，禁止推算",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "million-tokens",
              "credits"
            ]
          },
          "period": {
            "enum": [
              "month",
              "week",
              "five-hours"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "multimodal": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "buyUrl": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^https://",
        "description": "购买直达；仅 confidence=low 或 status=unknown 时允许为 null（validate.mjs 强制）"
      },
      "sourceUrl": {
        "type": "string",
        "pattern": "^https://"
      },
      "verifiedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "status": {
        "enum": [
          "active",
          "sold-out-daily",
          "discontinued",
          "coming-soon",
          "unknown",
          "no-plan"
        ]
      },
      "confidence": {
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "description": "high=官方页原文确认；medium=官方页但需推算或二手转述；low=未核实"
      },
      "notes": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 240
      },
      "includedCredit": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "description": "套餐附带的按金额计的用量额度（如 $60/月 credits），仅官方明写时填",
        "properties": {
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "enum": [
              "CNY",
              "USD"
            ]
          },
          "period": {
            "enum": [
              "month",
              "week",
              "day"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "text"
        ]
      },
      "quotaUnit": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "requests",
          "credits",
          "tokens",
          "multiplier",
          null
        ],
        "description": "quotaWindow 的单位：requests=请求次数，credits=厂商积分，tokens=token 数，multiplier=倍数（如 5x Pro）"
      },
      "platformId": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "platforms.json 里的平台 id；标注售卖主体是原厂/云平台/中转"
      }
    }
  }
}
